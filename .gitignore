# macOS metadata
.DS_Store
._*

# Node dependencies and logs (keep lockfiles versioned)
node_modules/
*.log
.npm/

# Python caches and local virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Local environment settings (keep example configuration versioned)
.env
.env.*
!.env.example
!.env.*.example

# Generated QA screenshots and reports
/qa/*.png
/qa/*.json
/playwright-report/
/test-results/

# Editor temporary files
*.swp
*.swo
*~
